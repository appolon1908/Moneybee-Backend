{
  "schemaVersion": 1,
  "repository": "appolon1908-hue/Moneybee-Backend",
  "serviceIdentity": "moneybee-api",
  "namespacePrefix": "moneybee/api/runtime/",
  "delivery": "agent-rendered-file",
  "bindings": [
    {
      "setting": "DATABASE_URL",
      "fileEnvironment": "DATABASE_URL_FILE",
      "secretName": "database-url",
      "required": true
    },
    {
      "setting": "REDIS_URL",
      "fileEnvironment": "REDIS_URL_FILE",
      "secretName": "redis-url",
      "required": true
    },
    {
      "setting": "CODESTRA_MIDDLEWARE_CLIENT_SECRET",
      "fileEnvironment": "CODESTRA_MIDDLEWARE_CLIENT_SECRET_FILE",
      "secretName": "codestra-middleware-client-secret",
      "required": false
    },
    {
      "setting": "CODESTRA_MIDDLEWARE_WEBHOOK_SECRET",
      "fileEnvironment": "CODESTRA_MIDDLEWARE_WEBHOOK_SECRET_FILE",
      "secretName": "codestra-middleware-webhook-secret",
      "required": false
    },
    {
      "setting": "PROVIDER_WEBHOOK_SECRETS_JSON",
      "fileEnvironment": "PROVIDER_WEBHOOK_SECRETS_JSON_FILE",
      "secretName": "provider-webhook-secrets-json",
      "required": false
    },
    {
      "setting": "FIELD_ENCRYPTION_KEYS_JSON",
      "fileEnvironment": "FIELD_ENCRYPTION_KEYS_JSON_FILE",
      "secretName": "field-encryption-keys-json",
      "required": false
    },
    {
      "setting": "PLAID_SECRET",
      "fileEnvironment": "PLAID_SECRET_FILE",
      "secretName": "plaid-secret",
      "required": false
    },
    {
      "setting": "CRM_API_KEY",
      "fileEnvironment": "CRM_API_KEY_FILE",
      "secretName": "crm-api-key",
      "required": false
    },
    {
      "setting": "ODOO_API_KEY",
      "fileEnvironment": "ODOO_API_KEY_FILE",
      "secretName": "odoo-api-key",
      "required": false
    },
    {
      "setting": "KYB_API_KEY",
      "fileEnvironment": "KYB_API_KEY_FILE",
      "secretName": "kyb-api-key",
      "required": false
    },
    {
      "setting": "MIDDESK_API_KEY",
      "fileEnvironment": "MIDDESK_API_KEY_FILE",
      "secretName": "middesk-api-key",
      "required": false
    },
    {
      "setting": "MIDDESK_WEBHOOK_SECRET",
      "fileEnvironment": "MIDDESK_WEBHOOK_SECRET_FILE",
      "secretName": "middesk-webhook-secret",
      "required": false
    },
    {
      "setting": "CREDIT_API_KEY",
      "fileEnvironment": "CREDIT_API_KEY_FILE",
      "secretName": "credit-api-key",
      "required": false
    },
    {
      "setting": "EXPERIAN_CLIENT_SECRET",
      "fileEnvironment": "EXPERIAN_CLIENT_SECRET_FILE",
      "secretName": "experian-client-secret",
      "required": false
    },
    {
      "setting": "LENDER_API_KEY",
      "fileEnvironment": "LENDER_API_KEY_FILE",
      "secretName": "lender-api-key",
      "required": false
    },
    {
      "setting": "SENDGRID_API_KEY",
      "fileEnvironment": "SENDGRID_API_KEY_FILE",
      "secretName": "sendgrid-api-key",
      "required": false
    },
    {
      "setting": "TWILIO_AUTH_TOKEN",
      "fileEnvironment": "TWILIO_AUTH_TOKEN_FILE",
      "secretName": "twilio-auth-token",
      "required": false
    },
    {
      "setting": "OBJECT_STORAGE_ACCESS_KEY",
      "fileEnvironment": "OBJECT_STORAGE_ACCESS_KEY_FILE",
      "secretName": "object-storage-access-key",
      "required": false
    },
    {
      "setting": "OBJECT_STORAGE_SECRET_KEY",
      "fileEnvironment": "OBJECT_STORAGE_SECRET_KEY_FILE",
      "secretName": "object-storage-secret-key",
